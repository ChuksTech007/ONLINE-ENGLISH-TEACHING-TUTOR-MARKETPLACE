generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum WalletTxType {
  PURCHASE
  DEDUCTION
  REFUND
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  DISCUSSION
  TRIAL_SCHEDULED
  ENROLLED
  CLOSED
}

enum LessonStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MeetingPlatform {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  OTHER
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  role          Role
  firstName     String
  lastName      String
  phone         String?
  country       String
  timezone      String     @default("UTC")
  emailVerified Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  sentMessages   Message[]
  notifications  Notification[]
  adminLogs      AdminAuditLog[]
  verifyTokens   EmailVerifyToken[]
}

model EmailVerifyToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String   @default("")
  level     String   @default("")
  goals     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries     Enquiry[]
  lessons       Lesson[]
  reviews       Review[]
  contacts      StudentTeacherContact[]
  conversations Conversation[]
}

model TeacherProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String          @unique
  photoUrl          String?
  bio               String          @default("")
  qualifications    String          @default("")
  experienceYears   Int             @default(0)
  specializations   String[]        @default([])
  levels            String[]        @default([])
  languages         String[]        @default([])
  isNativeSpeaker   Boolean         @default(false)
  hourlyRate        Decimal         @default(0) @db.Decimal(10, 2)
  currency          String          @default("USD")
  methodology       String          @default("")
  introVideoUrl     String?
  preferredPlatform MeetingPlatform @default(ZOOM)
  paymentMethods    Json            @default("[]")
  city              String          @default("")
  country           String          @default("")
  status            TeacherStatus   @default(PENDING)
  rejectionReason   String?
  featured          Boolean         @default(false)
  profileViews      Int             @default(0)
  averageRating     Decimal         @default(0) @db.Decimal(3, 2)
  reviewCount       Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  certificates  Certificate[]
  availability  AvailabilitySlot[]
  wallet        Wallet?
  enquiries     Enquiry[]
  lessons       Lesson[]
  reviews       Review[]
  contacts      StudentTeacherContact[]
  conversations Conversation[]
}

model Certificate {
  id         String         @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  fileName   String
  createdAt  DateTime       @default(now())
}

model AvailabilitySlot {
  id         String         @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startMinute Int
  endMinute  Int

  @@index([teacherId, dayOfWeek])
}

model Wallet {
  id               String         @id @default(cuid())
  teacherId        String         @unique
  teacher          TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  balance          Decimal        @default(0) @db.Decimal(12, 2)
  totalPurchased   Decimal        @default(0) @db.Decimal(12, 2)
  totalDeducted    Decimal        @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime       @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id              String       @id @default(cuid())
  walletId        String
  wallet          Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type            WalletTxType
  amount          Decimal      @db.Decimal(12, 2)
  previousBalance Decimal      @db.Decimal(12, 2)
  newBalance      Decimal      @db.Decimal(12, 2)
  reference       String       @unique
  description     String
  enquiryId       String?
  adminId         String?
  metadata        Json?
  createdAt       DateTime     @default(now())

  @@index([walletId, createdAt])
}

model CreditPackage {
  id          String   @id @default(cuid())
  name        String
  creditAmount Decimal @db.Decimal(12, 2)
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSettings {
  id                  String  @id @default("default")
  contactFee          Decimal @db.Decimal(10, 2)
  contactCurrency     String  @default("USD")
  allowNegativeWallet Boolean @default(false)
  siteName            String  @default("Merit English")
  supportEmail        String  @default("support@merit.local")
}

model StudentTeacherContact {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  firstEnquiryId String?
  chargedAmount Decimal       @db.Decimal(10, 2)
  createdAt    DateTime       @default(now())

  @@unique([studentId, teacherId])
}

model Enquiry {
  id                 String         @id @default(cuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  proficiencyLevel   String
  learningObjectives String
  preferredSchedule  String         @default("")
  message            String
  status             EnquiryStatus  @default(NEW)
  charged            Boolean        @default(false)
  chargeAmount       Decimal        @default(0) @db.Decimal(10, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([teacherId, createdAt])
  @@index([studentId, createdAt])
}

model Conversation {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages Message[]

  @@unique([studentId, teacherId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Lesson {
  id          String          @id @default(cuid())
  studentId   String
  student     StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String          @default("English lesson")
  description String          @default("")
  startAt     DateTime
  endAt       DateTime
  status      LessonStatus    @default(REQUESTED)
  platform    MeetingPlatform @default(ZOOM)
  meetingUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  review      Review?

  @@index([teacherId, startAt])
  @@index([studentId, startAt])
}

model Review {
  id              String         @id @default(cuid())
  lessonId        String         @unique
  lesson          Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  rating          Int
  teachingQuality Int
  communication   Int
  punctuality     Int
  comment         String
  hidden          Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([teacherId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())
}
